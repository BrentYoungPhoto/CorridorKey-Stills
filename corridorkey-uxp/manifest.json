{
  "id": "com.corridordigital.corridorkey",
  "name": "CorridorKey Green Screen Keyer",
  "version": "1.0.0",
  "main": "plugin.js",
  "host": [
    {
      "app": "PS",
      "minVersion": "25.0.0"
    }
  ],
  "manifestVersion": 6,
  "entrypoints": [
    {
      "type": "panel",
      "id": "corridorkey.panel",
      "label": {
        "default": "CorridorKey"
      },
      "minimumSize": {
        "width": 280,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 650
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["pluginList"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-dark.png",
          "scale": [1, 2],
          "theme": ["dark", "darkest"],
          "species": ["pluginList"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1", "http://localhost"]
    },
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  }
}
